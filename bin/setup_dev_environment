#!/usr/bin/env bash
# Source this file to prepare the development environment: start the
# postgres service, make sure the axum-demo database exists, and export
# PGPORT, DATABASE_URL and AXUM_PORT so `diesel migration run` and
# `cargo run` work. It is safe to source more than once.
#
# PGHOST and PGDATA are set by the `postgresql.dev` package to a data
# directory under .devbox/ that is shared across shells.

# If a server is already running against this data directory, reuse its port
# so DATABASE_URL stays in sync even when another shell started the service
# on a different port. Otherwise honor a pre-set PGPORT or fall back to 5432.
if [ -r "$PGDATA/postmaster.pid" ]; then
  running_port="$(sed -n '4p' "$PGDATA/postmaster.pid" 2>/dev/null || true)"
  if [ -n "$running_port" ] && pg_isready -h "$PGHOST" -p "$running_port" -q 2>/dev/null; then
    PGPORT="$running_port"
  fi
fi
export PGPORT="${PGPORT:-5432}"

[ -f "$PGDATA/PG_VERSION" ] || initdb >/dev/null

if ! pg_isready -h "$PGHOST" -p "$PGPORT" -q 2>/dev/null; then
  devbox services stop 2>/dev/null || true
  devbox services up -b
  for _ in $(seq 1 30); do
    pg_isready -h "$PGHOST" -p "$PGPORT" -q 2>/dev/null && break
    sleep 1
  done
fi

if ! pg_isready -h "$PGHOST" -p "$PGPORT" -q 2>/dev/null; then
  echo "Postgres did not become ready on port $PGPORT." >&2
  echo "Check the service output and .devbox/compose.log. To use a different" >&2
  echo "port, export PGPORT=[some other port] and retry." >&2
  return 1 2>/dev/null || exit 1
fi

# Create the axum-demo database if it is missing.
if ! psql -h "$PGHOST" -p "$PGPORT" axum-demo -c "select 1" -q >/dev/null 2>&1; then
  echo "Creating the axum-demo database"
  createdb -h "$PGHOST" -p "$PGPORT" axum-demo
fi

# The service listens on 127.0.0.1 (IPv4 only), so use that address rather than
# localhost, which can resolve to ::1 where the service is not listening.
export DATABASE_URL="postgres://127.0.0.1:${PGPORT}/axum-demo"

if [ -z "${AXUM_PORT:-}" ]; then
  export AXUM_PORT=3333
fi
