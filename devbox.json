{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.18.5/.schema/devbox.schema.json",
  "packages": [
    "rustup@latest",
    "git@latest",
    "postgresql@latest",
    "diesel-cli@latest",
    "postgresql.dev"
  ],
  "shell": {
    "init_hook": [
      "echo 'Welcome, try `devbox run migrate` and `devbox run dev`'"
    ],
    "scripts": {
      "setup": [
        "test -f \"$PGDATA/PG_VERSION\" || initdb"
      ],
      "dev": [
        "devbox run setup",
        "cargo run"
      ],
      "migrate": [
        "diesel migration run"
      ]
    }
  }
}
